    "case": "power-boost",
    "entry": "PowerBoostEntry",
    "recording": "tests/recordings/power-boost/power-boost.jsonl",
    "expect": {
        "completed": true,
        "hit_nodes": [
            "PowerBoostEntry",
            "PowerBoostPanel",
            "PowerBoostScroll",
            "PowerBoostPanel",
            "PowerBoostScroll",
            "PowerBoostPanel",
            "PowerBoostScroll",
            "PowerBoostPanel",
            "PowerBoostScroll",
            "PowerBoostPanel",
            "PowerBoostDone",
            "PowerBoostHome"
        ],
        "max_steps": 60
    }
}
