{
    // 世界这么大（日常）：把「虚轴之庭」的今日免费次数用快捷战斗刷完。
    // 流程（实测 2026-10-20，1280x720，emulator-5554 官服）：主界面左栏首个图标 → 存在感页签
    //   → 找到「世界这么大」→ 同行「前往」→ 虚轴之庭关卡选择页 →「出击」
    //   → 关卡详情页「快捷战斗」→ 确认 → 战斗结算「确定」→ 回详情页
    //   → 免费次数还有就继续，没有就收尾回主界面。
    // 关键事实：
    //   1) 任务描述是「挑战一次虚轴之庭的任意关卡」，打一轮后该行就从存在感列表消失，
    //      但「今日免费 X/6」（剩余次数）通常还剩 2~5 次。所以找不到任务行时不能直接收尾，
    //      改走顶部「战斗」页签 —— 它直接就是虚轴之庭关卡选择页，不依赖任务行；
    //   2) 「前往」用 target_offset (570,60) 绑定标题，与同列表其它任务一致（列表顺序会变）；
    //   3) 「出击」是动态发光的三角形按钮，OCR 读不出文字，位置固定在 (685,518)；
    //   4) 快捷战斗弹窗的次数 = min(3, 剩余免费次数)，剩 2 次时弹窗直接填 2；
    //   5) 免费次数用完后「今日免费 X/6」整行消失，改显示「消耗体力 35」，
    //      同时「快捷战斗」按钮消失（只剩灰的「选择助战好友」），这就是收尾信号；
    //   6) 关卡会随进度换名（阿兹塔·碎岩 → 阿兹塔·大地 → 八重之樱·散华），界面结构不变；
    //   7) 结算页「确定」的纵向位置随条目数浮动，点完还要约 1.5s 才淡出，两者都要留余量。
    "WorldTravelEntry": {
        "max_hit": 1,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    0,
                    130,
                    110,
                    100
                ],
                "template": "30_daily/FamiliarExplore/entry_icon.png"
            }
        },
        "action": {
            "type": "Click",
            "param": {
                // 图标只有 30x40，默认的随机点会落到边缘点不中（实测 41,160）；固定点中心
                "target": [
                    51,
                    174
                ]
            }
        },
        "next": [
            "WorldTravelPanel",
            "WorldTravelTab",
            "[JumpBack]CommonRewardPopup"
        ]
    },
    "WorldTravelTab": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    195,
                    150,
                    75
                ],
                "expected": ["存在感"]
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 3000,
        "next": ["WorldTravelPanel"]
    },
    "WorldTravelPanel": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    880,
                    140,
                    190,
                    55
                ],
                "expected": ["当前存在感"]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 5000,
        "rate_limit": 500,
        "next": [
            "WorldTravelFind",
            "WorldTravelScroll",
            "WorldTravelDone"
        ]
    },
    "WorldTravelFind": {
        "max_hit": 1,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    200,
                    250,
                    780,
                    430
                ],
                "expected": ["世界这么大"]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    570,
                    60,
                    0,
                    0
                ]
            }
        },
        "timeout": 2000,
        "next": ["WorldTravelStage"]
    },
    "WorldTravelScroll": {
        "max_hit": 4,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    880,
                    140,
                    190,
                    55
                ],
                "expected": ["当前存在感"]
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [
                    640,
                    620
                ],
                "end": [
                    640,
                    250
                ],
                "duration": 500
            }
        },
        "timeout": 3000,
        "next": ["WorldTravelPanel"]
    },
    "WorldTravelStage": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    1050,
                    120,
                    230,
                    70
                ],
                "expected": ["虚轴之庭"]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    685,
                    518
                ]
            }
        },
        "timeout": 10000,
        "next": ["WorldTravelDetail"],
        "on_error": ["WorldTravelHome"]
    },
    "WorldTravelDetail": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    600,
                    610,
                    300,
                    70
                ],
                "expected": ["选择助战好友"]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 10000,
        "rate_limit": 500,
        // 「消耗体力」要排在「快捷战斗」前面判定：免费次数用完后按钮未必立刻消失，
        // 先点快捷战斗就变成花体力打本了（这本来是个不消耗资源的日常）。
        // 末尾挂 Home 是死循环兜底：两个候选都不命中时不至于把整条日常拖崩。
        "next": [
            "WorldTravelNoFree",
            "WorldTravelQuick",
            "WorldTravelHome"
        ]
    },
    "WorldTravelQuick": {
        // 上限按「最坏情况每轮只打 1 场」留够 6 次免费；正常每轮 3 场只用 2~3 次
        "max_hit": 6,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    900,
                    600,
                    300,
                    100
                ],
                "expected": ["快捷战斗"]
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 2000,
        "next": ["WorldTravelConfirm"]
    },
    "WorldTravelConfirm": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    540,
                    235,
                    220,
                    70
                ],
                "expected": ["快捷战斗"]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    558,
                    471
                ]
            }
        },
        "timeout": 4000,
        "next": ["WorldTravelResult"],
        "on_error": ["WorldTravelHome"]
    },
    "WorldTravelResult": {
        // 结算页既当「进入点」又当 ResultOk 的「关干净了没」复查，一轮可能命中 2 次，
        // 所以上限要给到 2 倍轮数，否则第二轮之后就识别不到结算页了
        "max_hit": 8,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    560,
                    100,
                    400,
                    60
                ],
                "expected": ["战斗结算"]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 25000,
        "next": ["WorldTravelResultOk"],
        "on_error": ["WorldTravelHome"]
    },
    "WorldTravelResultOk": {
        // 用「确定」在不在做循环条件，不靠固定延时：
        //   结算页淡出期间和「多段结算要点两次确定」时，「确定」都还在 → 自己再命中一次再点；
        //   一旦淡出干净、按钮消失 → 落到 Detail 继续打下一轮。
        // 定长 post_delay 做不到这点（lint E105 也限制 ≤1000ms），
        // post_wait_freezes 会连续截图等静止，在离线 dryrun 里会把预设帧吃光。
        "max_hit": 8,
        "recognition": {
            "type": "OCR",
            "param": {
                // 「确定」位置随结算条目数上下浮动：条目多时 (760,599)，少时会上移到 y≈565，
                // 旧 roi [700,580,220,80] 上边界卡在 580，条目少的那轮识别不到 →
                // 确定没点上 → 后面全部失败 → 直接回主界面（剩下的免费次数就永远刷不掉）。
                "roi": [
                    680,
                    540,
                    320,
                    130
                ],
                "expected": ["确定"]
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 4000,
        "next": [
            "WorldTravelResultOk",
            "WorldTravelDetail"
        ],
        "on_error": ["WorldTravelHome"]
    },
    "WorldTravelNoFree": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    600,
                    570,
                    300,
                    60
                ],
                "expected": ["消耗体力"]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 2000,
        "next": ["WorldTravelHome"]
    },
    "WorldTravelDone": {
        // 存在感列表里已经没有「世界这么大」（当天任务已完成）——但「今日免费 6 次」
        // 通常还剩着，旧版在这里直接回主界面，导致剩 2~5 次免费次数永远刷不掉。
        // 改走顶部「战斗」页签：它直接就是虚轴之庭关卡选择页，不依赖任务行。
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    880,
                    140,
                    190,
                    55
                ],
                "expected": ["当前存在感"]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 2000,
        "next": ["WorldTravelBattleTab"],
        // 连「战斗」页签都读不到（停在某个没有顶部导航的层级）时直接收尾，别把整条日常拖崩
        "on_error": ["WorldTravelHome"]
    },
    "WorldTravelBattleTab": {
        "recognition": {
            "type": "OCR",
            "param": {
                // 顶部导航「战斗」(744,60,53,33)
                "roi": [
                    700,
                    50,
                    160,
                    60
                ],
                "expected": ["^战斗$"]
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 5000,
        "next": ["WorldTravelStage"],
        "on_error": ["WorldTravelHome"]
    },
    "WorldTravelHome": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    615,
                    50,
                    80,
                    50
                ],
                "expected": ["首页"]
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 10000,
        "next": []
    }
}
