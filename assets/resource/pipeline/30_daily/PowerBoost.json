            "param": {
                "target": [
                    522,
                    458
                ]
            }
        },
        "timeout": 4000,
        "next": ["PowerBoostBought"],
        "on_error": ["PowerBoostHome"]
    },
    "PowerBoostBought": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    400,
