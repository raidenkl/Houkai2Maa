{
    // 战力补强（日常）：到礼包商店买一件免费商品（当前是每日免费的「零时馈礼」）。
    // 流程（实测 2026-10-19，1280x720，MuMu 官服）：主界面左栏首个图标 → 存在感页签
    //   → 找到「战力补强」→ 同行「前往」→ 商店·礼包页 → 下滑找到「零时馈礼」
    //   → 购买 → 确认弹窗购买 → 「购买成功」确定 → 回主界面。
    // 关键事实：
    //   1) 任务说明是「购买一件『礼包商店』中的商品」，完成后该行从存在感列表消失；
    //   2) 「战力补强」标题是艺术字但可 OCR，实测会读成「战力补強」（繁体），
    //      所以锚点用正则 `战力补[強强]` 兼容两种字形；「前往」= 标题框 +(580,38)。
    //      早期（v2.0.0 及以前）锚的是说明文字「购买一件」，框宽 324px 而按钮只有
    //      155px，落点约一半在按钮外，实测三次全点空——锚点必须比目标窄，见 conventions §5.1；
    //   3) 「零时馈礼」在礼包页第二行第四列，价格 ×0（每日限购 1/1，不花水晶），
    //      故用价格「×0」作锚点 + offset (2,47) 点到「购买」按钮；
    //      价格不是 0 时不会命中，任务会安全停下（避免误买付费礼包）；
    //   4) 购买后顶上弹「战力补强 任务已完成」横幅并盖住导航栏，
    //      收尾靠识别「首页」自然等它消失；
    //   5) 找不到「战力补强」时下滑最多 4 次后正常收尾（当天已完成）。
    "PowerBoostEntry": {
        "max_hit": 1,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    0,
                    130,
                    110,
                    100
                ],
                "template": "30_daily/FamiliarExplore/entry_icon.png"
            }
        },
        "action": {
            "type": "Click",
            "param": {
                // 图标只有 30x40，默认的随机点会落到边缘点不中（实测 41,160）；固定点中心
                "target": [
                    51,
                    174
                ]
            }
        },
        "next": [
            "PowerBoostPanel",
            "PowerBoostTab",
            "[JumpBack]CommonRewardPopup"
        ]
    },
    "PowerBoostTab": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    195,
                    150,
                    75
                ],
                "expected": ["存在感"]
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 3000,
        "next": ["PowerBoostPanel"]
    },
    "PowerBoostPanel": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    880,
                    140,
                    190,
                    55
                ],
                "expected": ["当前存在感"]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 5000,
        "rate_limit": 500,
        "next": [
            "PowerBoostFind",
            "PowerBoostScroll",
            "PowerBoostDone"
        ]
    },
    "PowerBoostFind": {
        // 2026-10-23 重修：原锚点是说明文字「购买一件」，识别框实测 **324px 宽**，
        // 而「前往」按钮只有 155px（实测 x 960~1114, y 306~398，中心 1037,352）。
        // target_offset 以「框内随机点」为基准 → 落点铺满 324px，约一半落在按钮外
        // （v2.0.0 三次实测全部点空：x 1146 / 1173 / 1185，都在按钮右侧）。
        // 改锚**标题**「战力补强」：框实测只有 144px，比按钮还窄，偏移后整段落在按钮内。
        // 标题要用正则兼容两种字形——OCR 实测读成过「战力补強」（繁体「強」）。
        // max_hit 2 + next 回 Panel：点空一次还能重试，不再一次失手就收尾。
        "max_hit": 2,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    200,
                    250,
                    780,
                    430
                ],
                "expected": ["战力补[強强]"]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                // 标题框 [385,300,144,29] → 按钮中心 (1037,352)，即 +(580,38)。
                // 实测两种列表形态（该行在最顶/在最底）偏移后都落在按钮内。
                "target_offset": [
                    580,
                    38,
                    0,
                    0
                ]
            }
        },
        // 点完「前往」要等转场再判断落到哪个界面；timeout 用本节点的（框架限制的是
        // 「在本节点的 next 里找」的总时长，写 2000 时商店还没打开就判失败了）。
        "post_wait_freezes": 300,
        "timeout": 6000,
        // 没进商店就回 Panel 重试（max_hit 2 兜住次数）；
        // 当天已买过时这一行会消失，Find 不再命中，自然走到 Scroll → Done 收尾。
        "next": [
            "PowerBoostShop",
            "PowerBoostPanel"
        ]
    },
    "PowerBoostScroll": {
        "max_hit": 4,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    880,
                    140,
                    190,
                    55
                ],
                "expected": ["当前存在感"]
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [
                    640,
                    620
                ],
                "end": [
                    640,
                    250
                ],
                "duration": 500
            }
        },
        "timeout": 3000,
        "next": ["PowerBoostPanel"]
    },
    "PowerBoostShop": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    190,
                    120,
                    60
                ],
                "expected": ["月卡礼包"]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 10000,
        "rate_limit": 500,
        "next": [
            "PowerBoostGift",
            "PowerBoostShopScroll",
            "PowerBoostHome"
        ]
    },
    "PowerBoostShopScroll": {
        "max_hit": 3,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    190,
                    120,
                    60
                ],
                "expected": ["月卡礼包"]
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [
                    640,
                    560
                ],
                "end": [
                    640,
                    220
                ],
                "duration": 500
            }
        },
        "timeout": 3000,
        "next": ["PowerBoostShop"]
    },
    "PowerBoostGift": {
        "max_hit": 1,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    980,
                    180,
                    220,
                    400
                ],
                "expected": [
                    "×0",
                    "x0",
                    "X0"
                ]
            }
        },
        // 识别前先等画面冻结：本节点总是紧跟在 PowerBoostShopScroll（swipe）后面，
        // 惯性滚动中识别到的是运动中的位置，实测偏差 37px，点击会落到「数量」和
        // 「购买」之间的空隙里（点了没反应，PowerBoostConfirm 2s 后超时）。
        "pre_wait_freezes": {
            "time": 300,
            "target": [
                940,
                160,
                300,
                460
            ]
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    0,
                    47,
                    0,
                    0
                ]
            }
        },
        "timeout": 2000,
        "next": ["PowerBoostConfirm"]
    },
    "PowerBoostConfirm": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    520,
                    380,
                    240,
                    60
                ],
                "expected": ["是否购买零时馈礼"]
            }
        },
        "action": {
