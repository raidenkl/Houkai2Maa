        },
        "timeout": 3000,
        "next": ["ActivityFarmReady"],
        "on_error": ["ActivityFarmHome"]
    },
    "ActivityFarmNextPage": {
        "max_hit": 3,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    590,
                    630,
                    110,
                    60
                ],
                "expected": ["^[0-9]+/[0-9]+$"]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    741,
                    664
                ]
            }
        },
        "timeout": 3000,
        "next": ["ActivityFarmStage"]
    },
    "ActivityFarmReady": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    830,
                    515,
                    120,
                    50
                ],
                "expected": ["使用双倍券"]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 10000,
        "rate_limit": 500,
        "next": [
            "ActivityFarmCouponOn",
            "ActivityFarmCouponOff"
        ],
        "on_error": ["ActivityFarmHome"]
    },
    "ActivityFarmCouponOn": {
        // 不要加 max_hit：这两个节点靠「点完模板会从 off 变 on」自终止，
        // 加了 max_hit 反而会让第二次进备战页时彻底失效（券再也勾不上）。
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    1060,
                    505,
                    90,
                    80
                ],
                "template": ["30_daily/ActivityFarm/coupon_on.png"]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 2000,
        "next": ["ActivityFarmReadyGate"]
    },
    "ActivityFarmCouponOff": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    1060,
                    505,
                    90,
                    80
                ],
                "template": ["30_daily/ActivityFarm/coupon_off.png"]
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 2000,
        "next": ["ActivityFarmReadyGate"]
    },
    "ActivityFarmAssistOpen": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    640,
                    610,
                    190,
                    70
                ],
                "expected": ["选择助战好友"]
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 3000,
        "next": ["ActivityFarmAssist"]
    },
    "ActivityFarmReadyGate": {
        // 备战页右下角只有两种可能：「选择助战好友」（体力够）或「补充体力」（体力不够）。
        // 用 DirectHit 做分流，比 on_error 可靠（实测 on_error 这条兜底没生效）。
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "DoNothing"
        },
        "rate_limit": 300,
        "next": [
            "ActivityFarmNeedStamina",
            "ActivityFarmAssistOpen"
        ]
    },
    "ActivityFarmNeedStamina": {
        // 体力不够时，备战页右下角按钮会从「选择助战好友」变成「补充体力」。
        // 点它**不扣水晶**，只会弹确认窗（实测），所以这里放心点开交给下面两个弹窗节点处理。
        // max_hit 2：一次点出「兑换双倍体力」、再一次点出「补充体力（水晶）」；再多就回主界面。
        "max_hit": 2,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    660,
                    620,
                    180,
                    70
                ],
                "expected": ["补充体力"]
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 2500,
        // 点完先去等弹窗：回 Entry 会再次命中本节点（max_hit 2）连着点两次。
        "next": [
            "ActivityFarmExchangePopup",
            "ActivityFarmCrystalPopup",
            "ActivityFarmEntry"
        ],
        "on_error": ["ActivityFarmHome"]
    },
    "ActivityFarmAssist": {
        "max_hit": 15,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    340,
                    190,
                    180,
                    80
                ],
                "expected": ["备用装备"]
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 6000,
        "next": ["ActivityFarmStart"],
        "on_error": ["ActivityFarmHome"]
    },
    "ActivityFarmStart": {
        "max_hit": 15,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    770,
                    620,
                    130,
                    70
                ],
                "expected": ["开战"]
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 8000,
        "next": ["ActivityFarmWaitHud"],
        "on_error": ["ActivityFarmHome"]
    },
    "ActivityFarmWaitHud": {
        // 点「开战」后先过加载页，战斗 HUD（右上暂停按钮）要 8~20s 才出现（实测 19s）。
        // 等待时长由**当前节点**自己的 timeout 决定，候选节点的 timeout 不参与，
        // 所以不能让 ActivityFarmStart(8s) 直接等 TemplateMatch——
        // 实测 8s 一到就判 bad next，接着 on_error 里的主界面 OCR 也失败，
        // 框架再重试 on_error 直到报 "error handling loop detected"，整条任务中止。
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 45000,
        "rate_limit": 500,
        "next": ["ActivityFarmSwitchEquip"],
        // 开战时体力已不够：战斗 HUD 永远不会出现，接住两个体力弹窗
        "on_error": [
            "ActivityFarmExchangePopup",
            "ActivityFarmCrystalPopup",
            "ActivityFarmHome"
        ]
    },
    "ActivityFarmSwitchEquip": {
        // 等战斗 HUD 出来（暂停按钮是战斗内独有元素），再点左侧头像切到备用装备套装
        "max_hit": 15,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    1150,
                    0,
                    130,
                    72
                ],
                "template": ["30_daily/ActivityFarm/pause.png"]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    88,
                    154
                ]
            }
        },
        "timeout": 30000,
        "next": ["ActivityFarmBattleWait"],
        // 点「开战」时体力已经不够的话，战斗 HUD 永远不会出现，这里接住两个体力弹窗
        "on_error": [
            "ActivityFarmExchangePopup",
            "ActivityFarmCrystalPopup",
            "ActivityFarmHome"
        ]
    },
    "ActivityFarmBattleWait": {
        // 等自动战斗打完：切到备用装备后约 10~20s 清场，慢的时候 30s+。
        // 默认 timeout 是 20s，卡在快速清场那一档，打久了就判 bad next 直接中止。
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 90000,
        "rate_limit": 500,
        "next": [
            "ActivityFarmResult",
            "ActivityFarmDead"
        ]
    },
    "ActivityFarmResult": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    560,
                    100,
                    400,
                    60
                ],
                "expected": ["战斗结算"]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 45000,
        "next": [
            "ActivityFarmAgainOn",
            "ActivityFarmAgainOff"
        ]
    },
    "ActivityFarmAgainOn": {
        // 同 CouponOn/Off：靠「点完模板由 off 变 on」自终止，别写 max_hit——
        // 写了就只对第一次结算页生效，第二轮开始直接跳过，整个循环卡死在结算页。
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    655,
                    510,
                    95,
                    75
                ],
                "template": ["30_daily/ActivityFarm/again_on.png"]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 2000,
        "next": ["ActivityFarmAgain"]
    },
    "ActivityFarmAgainOff": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    655,
                    510,
                    95,
                    75
                ],
                "template": ["30_daily/ActivityFarm/again_off.png"]
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 2000,
        "next": ["ActivityFarmAgain"]
    },
    "ActivityFarmAgain": {
        "max_hit": 15,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    560,
                    580,
                    160,
                    70
                ],
                "expected": ["再次挑战"]
            }
        },
        "action": {
            "type": "Click"
        },
        // 结算页是半透明盖层，点完还要淡出约 1s；立刻回 Entry 的话它会在残留的
        // 「战斗结算」上再命中一次 ActivityFarmResult，形成假循环（实测第二轮就卡在这）。
        "post_delay": 900,
        "timeout": 3000,
        // 「再次挑战」回的是助战好友列表（备用装备已选中），直接接 Assist；
        // 万一是备战页则 Assist 识别不到，兜底回 Entry 重走一遍。
        "next": [
            "ActivityFarmAssist",
            "ActivityFarmEntry"
        ]
    },
    "ActivityFarmExchangePopup": {
        // 体力耗尽第一弹：兑换双倍体力。点「兑换」(532,458)，用掉 1 张双倍体力补 2 体力，
        // 然后回循环重新判断（体力仍不够时下一步会弹水晶窗，由 CrystalPopup 取消收尾）。
        // max_hit 1 是硬约束：兑换只补 2 点，对 50 消耗的 BONUS 关没有决定性作用，
        // 不限次的话券会被一张张换成 2 点体力，纯亏。
        "max_hit": 1,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    540,
                    220,
                    220,
                    60
                ],
                "expected": ["[兑兌]换双倍体力"]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    532,
                    458
                ]
            }
        },
        "timeout": 3000,
        "next": ["ActivityFarmEntry"]
    },
    "ActivityFarmExchangeCancel": {
        // 兑换额度用完后仍然弹兑换窗（双倍体力很多时）：改点「取消」，不再消耗，直接收尾。
        "max_hit": 2,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    540,
                    220,
                    220,
                    60
                ],
                "expected": ["[兑兌]换双倍体力"]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    745,
                    458
                ]
            }
        },
        "timeout": 3000,
        // 结算页取消后要按「确定」收掉；备战页取消后没有确定，直接回主界面。
        "next": [
            "ActivityFarmFinish",
            "ActivityFarmHome"
        ]
    },
    "ActivityFarmCrystalPopup": {
        "max_hit": 1,
        // 体力耗尽第二弹：花水晶补充体力。取消后直接收尾，不再挑战
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    540,
                    220,
                    220,
                    60
                ],
                "expected": ["补充体力"]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    745,
                    458
                ]
