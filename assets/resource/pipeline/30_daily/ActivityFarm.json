        },
        // 点完页签要等页面切过去；否则 Entry 会在同一帧再次命中导航栏的「战斗」
        "post_delay": 700,
        "timeout": 3000,
        "next": ["ActivityFarmEntry"]
    },
    "ActivityFarmActivityTab": {
