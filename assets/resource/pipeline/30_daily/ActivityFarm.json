    "ActivityFarmLastPage": {
        // 「N/N」= 已是最后一页；BONUS 关在活动关卡列表的最后一页
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    590,
                    630,
                    110,
                    60
                ],
                "expected": ["^([0-9]+)/\\1$"]
            }
