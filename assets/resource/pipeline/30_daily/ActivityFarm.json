    "ActivityFarmFindBonus": {
        "max_hit": 1,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    140,
                    210,
                    300,
                    90
                ],
                "expected": ["BONUS"]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                // BONUS 标签下的关卡卡片（标签本身不可点）
                "target_offset": [
                    0,
                    70,
                    0,
                    0
                ]
