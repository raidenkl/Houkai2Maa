{
    // 活动清体力（日常）：进当期活动刷 BONUS 关，循环「再次挑战」直到体力耗尽。
    // 流程（实测 2026-10-19，1280x720，emulator-5554 官服，海妖秘境）：
    //   战斗页签·活动 → 点当期活动名 → 关卡页 → 点 BONUS 下方关卡 → 备战页
    //   → 勾「使用双倍券」→「选择助战好友」→「备用装备」→「开战」
    //   → 战斗中【点左侧角色头像切到备用装备套装 = 自动战斗】
    //   → 战斗结算 → 勾「使用双倍券」→「再次挑战」→ 助战页 …… 循环
    //   → 体力耗尽时弹「兑换双倍体力」/「补充体力(花费60水晶)」→ 取消 → 收尾回主界面。
    // 关键事实：
    //   1) 备用装备套装有自动战斗装备：切过去后不用任何操作，约 10~20s 自动清场到结算页；
    //      不切的话角色站着不动，约 70s 会被打死（见 ActivityFarmDead）。
    //   2) 备战页与结算页的双倍券勾选框**每次进入都是未勾选**（实测两次/三次），
    //      但结算页曾有已勾选的历史状态，故两个页面都用「已勾/未勾」模板判别后再点，不盲点。
    //   3) 勾了双倍券后「消耗体力」会翻倍（50 → 100），这是它唯一的文字副作用。
    //   4) 「再次挑战」回到的是**助战好友列表**，不是直接开战，所以循环里要重走
    //      备用装备 → 开战 → 点头像。
    //   5) 体力不足时备战页右下按钮从「选择助战好友」变成「补充体力」，点它**不会直接扣水晶**，
    //      而是先弹窗（实测 2026-10-19）：有双倍体力 →「兑换双倍体力」（换 1 张补 2 体力）；
    //      没有 →「补充体力（花 60 水晶）」。所以兑换上限设 1 次：2 点体力远不够 50 消耗，
    //      换完仍然会弹水晶窗，再多换只是把券一张张烧掉。水晶窗一律「取消」，绝不点「确定」。
    //   6) 死亡弹窗「救救我」的「确定」是花 60 水晶复活，必须走「返回」→「退出关卡」。
    //   7) 点「开战」后要过加载页，战斗 HUD 8~20s 才出现；等多久由**当前节点**的 timeout
    //      决定，所以中间夹 ActivityFarmWaitHud（DirectHit，45s），不能让 Start(8s) 直接等。
    //      等结算的 ActivityFarmBattleWait 同理要 90s（自动战斗 10~20s + 淡出）。
    //   8) 勾选框节点（Coupon/Again 的 on/off）**不能写 max_hit**：max_hit 是整次任务的
    //      累计命中数，写了第二轮开始就被跳过，结算页卡死 45s 后任务失败。
    //   9) 「再次挑战」后要 post_delay 等结算页淡出，否则 Entry 会在残留的「战斗结算」
    //      上再命中 Result，形成假循环。
    "ActivityFarmEntry": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "DoNothing"
        },
        "rate_limit": 300,
        "next": [
            "ActivityFarmCrystalPopup",
            "ActivityFarmExchangePopup",
            "ActivityFarmExchangeCancel",
            "ActivityFarmDead",
            "ActivityFarmNeedStamina",
            "ActivityFarmResult",
            "ActivityFarmReady",
            "ActivityFarmAssist",
            "ActivityFarmStart",
            "ActivityFarmStage",
            "ActivityFarmList",
            "ActivityFarmActivityTab",
            "ActivityFarmBattleTab",
            "[JumpBack]CommonRewardPopup"
        ],
        "on_error": ["ActivityFarmHome"]
    },
    "ActivityFarmHome": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    615,
                    50,
                    80,
                    52
                ],
