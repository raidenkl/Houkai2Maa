{
    // 共鸣之力（日常）：刷新一次「共鸣屋」中的商品。
    // 流程（实测 2026-10-18，1280x720）：主界面左栏首个图标 → 存在感页签 → 找到「共鸣之力」
    //   → 点同行「前往」→ 共鸣屋 → 右上刷新按钮 → 「你确定要进行免费刷新吗？」→ 确定 → 回主界面。
    // 关键事实：
    //   1) 完成后该行会从存在感列表消失，因此不会重复刷新；
    //   2) 列表可滚动且顺序不固定，「前往」按钮用 target_offset 绑定到标题所在行，不写死行坐标；
    //   3) 刷新后顶部弹出「共鸣之力 任务已完成」提示会盖住导航栏约 2 秒，
    //      故 Home 节点靠识别「首页」自然等待提示消失；
    //   4) 只剩付费刷新（剩余次数 0 次）时不点刷新，直接收尾，不消耗水晶；
    //   5) 找不到「共鸣之力」时下滑最多 4 次后正常收尾（当天已完成的情况）。
    // 入口分流：单独运行本任务时，界面可能停在上一次失败残留的共鸣屋（一键日常崩在半路时就是这样）。
    // DirectHit 保证入口一定进得去（主界面没有可 OCR 的固定入口文案），
    // 再按「剩余次数」判断：已在共鸣屋就直接续跑，否则回落原入口点左栏图标。
    // 实测 2026-10-22：单跑任务时界面停在共鸣屋，ResonanceRefreshEntry 模板匹配只有 0.469（阈值 0.85），
    // 20s 后 Task timeout 整个任务失败。
    "ResonanceRefreshStart": {
        "recognition": {
            "type": "DirectHit"
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 10000,
        "next": [
            "ResonanceRefreshShop",
            "ResonanceRefreshEntry"
        ]
    },
    "ResonanceRefreshEntry": {
        "max_hit": 1,
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "roi": [
                    0,
                    130,
                    110,
                    100
                ],
                "template": "30_daily/FamiliarExplore/entry_icon.png"
            }
        },
        "action": {
            "type": "Click",
            "param": {
                // 图标只有 30x40，默认的随机点会落到边缘点不中（实测 41,160）；固定点中心
                "target": [
                    51,
                    174
                ]
            }
        },
        "next": [
            "ResonanceRefreshPanel",
            "ResonanceRefreshTab",
            "[JumpBack]CommonRewardPopup"
        ]
    },
    "ResonanceRefreshTab": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    0,
                    195,
                    150,
                    75
                ],
                "expected": ["存在感"]
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 3000,
        "next": ["ResonanceRefreshPanel"]
    },
    "ResonanceRefreshPanel": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    880,
                    140,
                    190,
                    55
                ],
                "expected": ["当前存在感"]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 5000,
        "rate_limit": 500,
        "next": [
            "ResonanceRefreshFind",
            "ResonanceRefreshScroll",
            "ResonanceRefreshDone"
        ]
    },
    "ResonanceRefreshFind": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    200,
                    250,
                    780,
                    430
                ],
                "expected": ["共鸣之力"]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target_offset": [
                    570,
                    60,
                    0,
                    0
                ]
            }
        },
        // 点完「前往」要等转场，再判断落到哪个界面。
        // timeout 必须 ≥ 共鸣屋的加载时间：框架限制「在 next 里找后继」用的是**本节点**的
        // timeout，写 2000 会在共鸣屋还没出来时就把节点判失败（实测 2294ms 中止整个任务）。
        "post_wait_freezes": 300,
        "timeout": 6000,
        // 兜底 ResonanceRefreshDone：当天已经刷新过时，「共鸣之力」这一行还在、
        // OCR 照样命中标题，但「前往」已失效，点了只把任务行标记完成、不会进共鸣屋。
        // 没有这条兜底的话整个一键日常会在这里崩掉（实测 2026-10-20）。
        "next": [
            "ResonanceRefreshShop",
            "ResonanceRefreshDone"
        ]
    },
    "ResonanceRefreshScroll": {
        "max_hit": 4,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    880,
                    140,
                    190,
                    55
                ],
                "expected": ["当前存在感"]
            }
        },
        "action": {
            "type": "Swipe",
            "param": {
                "begin": [
                    640,
                    620
                ],
                "end": [
                    640,
                    250
                ],
                "duration": 500
            }
        },
        "post_wait_freezes": {
            "time": 400,
            "target": [
                200,
                250,
                780,
                430
            ]
        },
        "timeout": 3000,
        "next": ["ResonanceRefreshPanel"]
    },
    "ResonanceRefreshShop": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    820,
                    110,
                    270,
                    60
                ],
                "expected": ["剩余次数"]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 6000,
        "next": [
            "ResonanceRefreshFree",
            "ResonanceRefreshNoFree"
        ]
    },
    "ResonanceRefreshFree": {
        // 刷新按钮是 48x48 的固定圆形图标（圆心实测 1088,153，两天的截图逐像素一致），
        // 而「剩余次数 N 次」的文字框宽 130、位置还会随字数浮动。
        // 原来用 target_offset[150,20] 从文字框内随机点偏移，点击 x 落在 1021~1151 区间里随机，
        // 只有约 37% 概率压中按钮（1064~1112）——2026-10-22 19:13:20 正好点在 1035,168 的空白处，
        // 界面没反应、ResonanceRefreshConfirm 等不到弹窗，整个一键日常崩在共鸣之力。
        // 结论：位置固定的窄按钮一律写死 target，别用 offset。
        // max_hit 2 = 允许一次「点了被转场吞掉」的重试；两次都失败才交给 Home 收尾。
        "max_hit": 2,
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    820,
                    110,
                    270,
                    60
                ],
                "expected": [
                    "剩余次数1次",
                    "剩余次数2次",
                    "剩余次数3次",
                    "剩余次数4次",
                    "剩余次数5次"
                ]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                "target": [
                    1088,
                    153
                ]
            }
        },
        "timeout": 3000,
        "next": [
            "ResonanceRefreshConfirm",
            "ResonanceRefreshFree",
            "ResonanceRefreshHome"
        ]
    },
    "ResonanceRefreshConfirm": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    330,
                    180,
                    600,
                    300
                ],
                "expected": ["免费刷新"]
            }
        },
        "action": {
            "type": "Click",
            "param": {
                // 弹窗按钮实测：确定圆心 (533,452)、取消圆心 (747,452)，按钮约 200x58。
                // 确定用固定点，取消交给识别框中心（「取消」二字本身就在按钮正中）。
                "target": [
                    533,
                    452
                ]
            }
        },
        "timeout": 6000,
        "next": ["ResonanceRefreshHome"],
        "on_error": ["ResonanceRefreshCancel"]
    },
    "ResonanceRefreshCancel": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    330,
                    180,
                    600,
                    300
                ],
                "expected": ["取消"]
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 1500,
        "next": ["ResonanceRefreshHome"]
    },
    "ResonanceRefreshNoFree": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    820,
                    110,
                    270,
                    60
                ],
                "expected": ["剩余次数0次"]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 1500,
        "next": ["ResonanceRefreshHome"]
    },
    "ResonanceRefreshDone": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    880,
                    140,
                    190,
                    55
                ],
                "expected": ["当前存在感"]
            }
        },
        "action": {
            "type": "DoNothing"
        },
        "timeout": 2000,
        "next": ["ResonanceRefreshHome"]
    },
    "ResonanceRefreshHome": {
        "recognition": {
            "type": "OCR",
            "param": {
                "roi": [
                    615,
                    50,
                    80,
                    50
                ],
                "expected": ["首页"]
            }
        },
        "action": {
            "type": "Click"
        },
        "timeout": 10000,
        "next": []
    }
}
