{
    // 全局默认参数（MaaFramework v5.3+）。
    // 优先级：节点显式配置 > 本文件算法/动作默认 > 本文件 Default > 框架内置默认。
    // 文档：https://github.com/MaaXYZ/MaaFramework/blob/main/docs/zh_cn/3.1-任务流水线协议.md#默认属性
    //
    // ⚠️ pre_delay / post_delay 曾经是 0（「为了快」），2026-10-21 实测的后果是
    // **点击被客户端吞掉**：连环操作的间隔只有 60~130ms（见 debug/maafw.log 的节点时间线），
    // 页面转场/淡出期间的触摸事件游戏直接丢弃，表现为
    //   · 「再次挑战」点了没反应 → 1.5s 后又点一次（双倍券被来回勾）
    //   · 战斗里点头像切备用装备没生效 → 角色站桩 → BattleWait 90s 超时
    // 框架内置默认就是 200/200，是有道理的，别关。
    //
    // 现在的取值：识别到 → 等 200ms → 点击 → 等 400ms → 截图识别下一个节点。
    // 一次点击到下一次点击约 650~700ms（含链路里几个识别节点），接近人的手速，
    // 转场基本能走完。代价是一键日常大约多花 60~90s，值。
    // 想再稳一点就整体上调 post_delay（上限 1000，见 lint E105）；
    // 单点需要更长缓冲时给该节点单独写，别动这里。
    "Default": {
        "rate_limit": 300,
        "timeout": 20000,
        "pre_delay": 200,
        "post_delay": 400
    },
    "TemplateMatch": {
        "recognition": {
            "type": "TemplateMatch",
            "param": {
                "threshold": 0.85,
                "method": 5
            }
        }
    },
    "FeatureMatch": {
        "recognition": {
            "type": "FeatureMatch",
            "param": {
                "detector": "SIFT",
                "ratio": 0.6
            }
        }
    },
    "OCR": {
        "recognition": {
            "type": "OCR",
            "param": {
                "threshold": 0.4,
                "order_by": "Horizontal"
            }
        }
    },
    "Click": {
        "action": {
            "type": "Click",
            "param": {
                "target": true
            }
        }
    },
    "LongPress": {
        "action": {
            "type": "LongPress",
            "param": {
                "target": true,
                "duration": 300
            }
        }
    }
}
