                            // 3s 时 5/5 命中。
                            "recognition": {
                                "type": "OCR",
                                "param": {
                                    "roi": [
                                        615,
                                        50,
                                        80,
                                        52
                                    ],
                                    "expected": ["首页"]
                                }
                            },
                            "action": {"type": "Click"},
                            "post_delay": 3000,
                            "timeout": 8000,
                            "next": ["ActivityFarmEntry"]
                        },
                        // 第二轮刷本的挂载点：魔女那 100 体力是**点「领取」直接到账**的
                        // （不等一键领取），所以领完立刻接第二轮，把新体力刷掉；
                        // 一键领取仍然留到最后，顺带把第二轮刷出来的日常奖励一起领了。
                        // 没勾本 step 时这段 override 不生效，MagicWitchDone 用 task 级
                        // 默认值直接去一键领取 —— 不会被动刷本。
                        "MagicWitchDone": {
                            "next": [
                                "OneClickDailyFarmAgainGate",
                                "OneClickDailyClaimAllGate"
                            ]
                        },
                        "OneClickDailyFarmAgainGate": {
                            // 和第二轮的 ActivityFarmEntry 之间同样补一刀「首页」+ 等转场
                            // （魔女链路收尾不回主界面，停在存在感页）。
                            "recognition": {
                                "type": "OCR",
                                "param": {
                                    "roi": [
                                        615,
                                        50,
                                        80,
                                        52
                                    ],
