{
    // 活动清体力（日常）：进当期活动刷 BONUS 关，循环到体力耗尽。
    // 由 assets/interface.json 的 import 引入；改动后跑 npm run lint 校验引用。
    "task": [
        {
            "name": "ActivityFarm",
            "label": "活动清体力",
            "entry": "ActivityFarmBegin",
            "default_check": false,
            "description": "把体力刷在当期活动的 BONUS 关：自动勾双倍券、选备用装备、开战后切备用装备套装自动战斗，结算后「再次挑战」循环，直到体力不足（弹「兑换双倍体力 / 补充体力」时点取消）。活动会随版本变化，请先在「当期活动」里填活动名。循环由 Agent 计数（场次/死亡/兑换额度/轮次），不再依赖 max_hit；场次上限 20 只是安全网，正常靠体力耗尽收尾。",
            "group": [
                "daily"
            ],
            "option": [
                "ActivityName",
                "ActivityFarmDouble"
            ]
        }
    ],
    "option": {
        "ActivityName": {
            "type": "input",
            "label": "当期活动",
            "description": "填活动页签里要刷的活动名，例如「月光下的拜访」「多元裂缝」。如果标题是美术字被 OCR 拆开（实测「海妖秘境」会读成「海妖」「秘境」两段），只填其中一个词即可，比如「海妖」。留空或保持默认值会识别不到活动，任务直接收尾。",
            "inputs": [
                {
                    "name": "活动名",
                    "label": "活动名称",
                    "default": "请填写活动名",
                    "pipeline_type": "string"
                }
            ],
            "pipeline_override": {
                "ActivityFarmPick": {
                    "recognition": {
                        "param": {
                            "expected": ["{活动名}"]
                        }
                    }
                },
                "ActivityFarmBannerMatch": {
                    "recognition": {
                        "param": {
                            "expected": ["{活动名}"]
                        }
                    }
                }
            }
        },
        "ActivityFarmDouble": {
            "type": "switch",
            "label": "使用双倍券",
            "description": "开启后每次战斗前都会勾上「使用双倍券」（体力消耗翻倍、奖励翻倍）。券用完或只想用普通体力刷时关掉。",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {}
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "ActivityFarmReady": {
                            "next": ["ActivityFarmAssistOpen"]
                        },
                        "ActivityFarmResult": {
                            "next": ["ActivityFarmAgain"]
                        }
                    }
                }
            ],
            "default_case": "Yes"
        }
    }
}
