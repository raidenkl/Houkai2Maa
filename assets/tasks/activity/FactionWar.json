            "option": [
                "FactionWarDouble"
            ]
        }
    ],
    "option": {
        "FactionWarDouble": {
            "type": "switch",
            "label": "使用双倍体力券",
            "description": "关闭后不会再尝试兑换/使用双倍体力券（适合券已用完、只想用普通体力刷）。",
            "cases": [
                {
                    "name": "Yes",
                    "pipeline_override": {}
                },
                {
                    "name": "No",
                    "pipeline_override": {
                        "FactionWarExchangeDouble": {
                            "enabled": false
                        }
                    }
                }
            ],
            "default_case": "Yes"
        }
    }
