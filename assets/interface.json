{
    // Project Interface V2 协议：https://github.com/MaaXYZ/MaaFramework/blob/main/docs/zh_cn/3.3-ProjectInterfaceV2协议.md
    // 开发约定见 AGENTS.md；坐标基准 1280x720（16:9）。
    "interface_version": 2,
    "name": "MaaHoukai2",
    "label": "崩坏学园2 小助手",
    "github": "https://github.com/raidenkl/Houkai2Maa",
    "version": "2.0.0",
    "contact": "https://github.com/raidenkl/Houkai2Maa/issues",
    "license": "MIT",
    "welcome": "欢迎使用 MaaHoukai2！先在「控制器」里连上模拟器（分辨率建议 1280×720），再到「一键日常」勾选要跑的步骤即可。",
    "description": "崩坏学园2 日常自动化：启动/登录 → 回主界面 → 领奖 → 体力刷本。由 MaaFramework 驱动。",
    "controller": [
        {
            "name": "安卓端",
            "label": "安卓端（16:9 / 720p 基准）",
            "description": "通过 ADB 连接模拟器或手机。请把分辨率设为 1280×720（16:9）。",
            "type": "Adb",
            "display_short_side": 720
        },
        {
            // 实验性：窗口匹配尚未实测，待 Phase 5 验证后转正
            "name": "桌面端",
            "label": "桌面端（实验性）",
            "description": "通过 Win32 连接 PC 客户端；窗口类名/标题待实测，暂不建议使用。",
            "type": "Win32",
            "win32": {
                "class_regex": ".*",
                "window_regex": "崩坏学园2",
                "screencap": "PrintWindow",
                "mouse": "PostMessageWithCursorPos",
                "keyboard": "PostMessageWithCursorPos"
            }
        }
    ],
    "resource": [
        {
            "name": "官服",
            "label": "官服",
            "path": [
                "./resource"
            ]
        },
        {
            "name": "B 服",
            "label": "B 服",
            "path": [
                "./resource"
            ]
        }
    ],
    // 预任务 / Agent：**仓库里刻意不写**，由 `tools/install.py` 打包时注入。
    //
    // 为什么不在仓库写：开发机直接让 MFA 指向 `assets/` 时包里并没有 `python/`，
    // 一旦写了 agent 块，初始化链会中止（对用户表现为「连不上模拟器」）。
    //
    // 踩过的坑（2026-10-21 实测，MFAAvalonia 2.x）：
    //   - pretask 的 `exec` 会被 MFA 无条件拼到 `<包根>/resource/base/` 下
    //     （MaaInterface.ReplacePlaceholder(exec, ResourceBase) 没开路径检查），
    //     所以写裸 `python` 必然被解释成 `resource\base\python` → Win32Exception(2)，
    //     接着整条 MAA 初始化链中止，界面上的表现是「连不上模拟器」。
    //   - agent 的 `child_exec` 走的是 `Path.Combine(DataRoot, ...)` + 存在性检查，
    //     裸 `python` 会退化成 PATH 查找，本机没装 Python 就同样起不来。
    //
    // 现在的做法（见 tools/shared/packaging.py）：
    //   * 只有 win-x64 的安装包随带嵌入式 Python（`python/` 放包根，预装 maafw）；
    //   * `install.py` 检测到 `deps/python` 才注入 agent 块：
    //         "agent": { "child_exec": "./python/python.exe", "child_args": ["./agent/main.py"] }
    //   * 其它平台移除 agent / pretask，保持纯 JSON 可用；
    //   * `verify_install()` 会同时校验 child_exec 存在，以及「有 Custom 节点就必须有 agent 块」。
    //
    // pretask（分辨率体检）仍未启用：它需要 `{PROJECT_DIR}/../../python/python.exe`
    // 这种绕路写法（`{PROJECT_DIR}` == `<包根>/resource/base`，不是包根），
    // 等 ActivityFarm 的 Agent 改造真机跑稳后再单独开。
    //
    // "pretask": {
    //     "controller": ["安卓端"],
    //     "exec": "{PROJECT_DIR}/../../python/python.exe",
    //     "args": ["./agent/pretask/device_prepare.py"],
    //     "name": "DevicePrepare",
    //     "label": "设备分辨率检查",
    //     "description": "启动前检查设备截图是否为 1280×720（16:9）。不符会中止并给出修改方法。"
    // },
    "group": [
        {
            "name": "oneclick",
            "label": "一键日常",
            "description": "把多个日常串成一条流程，可逐步勾选是否执行",
            "default_expand": true
        },
        {
            "name": "launch",
            "label": "启动",
            "description": "启动客户端、进入游戏、清理登录弹窗",
            "default_expand": true
        },
        {
            "name": "daily",
            "label": "日常",
            "description": "每天需要完成的玩法",
            "default_expand": true
        },
        {
            "name": "activity",
            "label": "活动",
            "description": "随版本变动的活动玩法（阵营战等）",
            "default_expand": true
        },
        {
            "name": "tools",
            "label": "工具",
            "description": "调试与辅助任务",
            "default_expand": false
        }
    ],
    "task": [],
    "import": [
        "tasks/oneclick/OneClickDaily.json",
        "tasks/launch/LaunchGame.json",
        "tasks/activity/FactionWar.json",
        "tasks/daily/FamiliarExplore.json",
        "tasks/daily/FireRescue.json",
        "tasks/daily/ResonanceRefresh.json",
        "tasks/daily/WorldTravel.json",
        "tasks/daily/PowerBoost.json",
        "tasks/daily/ClubStamina.json",
        "tasks/daily/ActivityFarm.json",
        "tasks/daily/MagicWitch.json"
    ],
    "preset": [
        {
            "name": "ActivityOnly",
            "label": "只做活动",
            "description": "只勾选活动玩法（目前为阵营战）。",
            "task": [
                {
                    "name": "FactionWar"
                }
            ]
        }
    ]
}
